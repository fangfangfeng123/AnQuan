# 安全评估系统后端 .env 配置文件
# 复制此文件为 .env 并根据实际环境修改

# ── 应用基础 ──
APP_NAME=安全评估系统
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=dev-secret-key-change-in-production
API_TOKEN=dev-api-token-change-in-production

# ── 数据库 ──
DATABASE_URL=postgresql+asyncpg://sec_user:sec_password@localhost:15433/sec_eval

# ── Redis ──
REDIS_URL=redis://localhost:6379/0

# ── Docker 沙箱 ──
DOCKER_HOST=npipe:////./pipe/dockerDesktopLinuxEngine
SANDBOX_IMAGE_DEFAULT=sec-eval/python-scanner:latest
SANDBOX_NETWORK_MODE=restricted
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_CPU_LIMIT=1
SANDBOX_TIMEOUT_SECS=1800

# ── LLM 配置 ──
LLM_MODE=demo
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
LLM_TEMPERATURE=0.1

# ── CORS ──
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── 文件路径 ──
UPLOAD_DIR=./data/uploads
REPORT_TEMPLATE_DIR=./report-templates
SNAPSHOT_DIR=./data/snapshots

# ── 上传限制 ──
UPLOAD_MAX_SIZE_MB=200
